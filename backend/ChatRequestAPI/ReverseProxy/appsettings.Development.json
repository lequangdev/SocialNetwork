{
    "ReverseProxyAuth": {
        "Routes": {
            "route-auth-register": {
                "ClusterId": "cluster-auth",
                "Match": {
                    "Path": "api-auth/auth/Register"
                },
                "Transforms": [
                    { "PathPattern": "api/AuthUser/InsertUser" }
                ],
            },
            "route-auth-login": {
                "ClusterId": "cluster-auth",
                "Match": {
                    "Path": "api-auth/auth/Login"
                },
                "Transforms": [
                    { "PathPattern": "api/AuthUser/Login" }
                ]
            },
            "route-auth-secured": {
                "ClusterId": "cluster-auth",
                "Match": {
                    "Path": "api-auth/{**catch-all}"
                },
                "Transforms": [
                    { "PathPattern": "api/{**catch-all}" }
                ],
                //"AuthorizationPolicy": "AuthenticatedOnly"

            }
        },
        "Clusters": {
            "cluster-auth": {
                "Destinations": {
                    "service": { "Address": "http://localhost:5200" }
                }
            }
        }
    },
    "ReverseProxyChat": {
        "Routes": {
            "route-chat": {
                "ClusterId": "cluster-chat",
                "Match": {
                    "Path": "api-chat/{**catch-all}"
                },
                "Transforms": [
                    { "PathPattern": "api/{**catch-all}" }
                ],
                //"AuthorizationPolicy": "AuthenticatedOnly"

            }
        },
        "Clusters": {
            "cluster-chat": {
                "Destinations": {
                    "service": { "Address": "http://localhost:5300" }
                }
            }
        }
    },
    "ReverseProxyPost": {
        "Routes": {
            "route-Post": {
                "ClusterId": "cluster-post",
                "Match": {
                    "Path": "api-post/{**catch-all}"
                },
                "Transforms": [
                    { "PathPattern": "api/{**catch-all}" }
                ],
                "AuthorizationPolicy": "AuthenticatedOnly"

            }
        },
        "Clusters": {
            "cluster-post": {
                "Destinations": {
                    "service": { "Address": "http://localhost:5400" }
                }
            }
        }
    },
    "JwtConfiguration": {
        "SecretKey": "setkeyjwt030705999999999999999999",
        "Issuer": "developer",
        "Audience": "client",
        "ExpiryMinutes": 60
    }
}
